@page
@model DiagModel
@{
    ViewData["Tab"] = "settings";
    ViewData["HideHouseholdBanner"] = true;
}
@await Html.PartialAsync("_SubHeader", ("Diagnostics", Url.Page("/Settings/Index")!))

<p class="small muted">Temporary page for checkpoint A. Removed in the final release.</p>

<h2>Request</h2>
<dl class="kv">
    <dt>X-Ingress-Path</dt><dd>@Model.Header("X-Ingress-Path")</dd>
    <dt>PathBase</dt><dd>@(Request.PathBase.HasValue ? Request.PathBase.Value : "(empty)")</dd>
    <dt>X-Remote-User-Id</dt><dd>@Model.Header("X-Remote-User-Id")</dd>
    <dt>X-Remote-User-Name</dt><dd>@Model.Header("X-Remote-User-Name")</dd>
    <dt>X-Remote-User-Display-Name</dt><dd>@Model.Header("X-Remote-User-Display-Name")</dd>
    <dt>Current user</dt><dd>@Model.User.DisplayName (@Model.User.Id)</dd>
    <dt>RemoteIp</dt><dd>@HttpContext.Connection.RemoteIpAddress</dd>
    <dt>Local time</dt><dd>@DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss")</dd>
    <dt>Time zone</dt><dd>@TimeZoneInfo.Local.Id</dd>
    <dt>UI culture</dt><dd>@System.Globalization.CultureInfo.CurrentUICulture.Name</dd>
    <dt>Culture</dt><dd>@(System.Globalization.CultureInfo.CurrentCulture.Name is { Length: > 0 } c ? c : "invariant")</dd>
    <dt>Date (UI culture)</dt><dd>@Texts.ShortDate(DateOnly.FromDateTime(DateTime.Now), System.Globalization.CultureInfo.CurrentUICulture)</dd>
    <dt>Add-on slug</dt><dd>@(Model.Slug ?? "(unknown)")</dd>
    <dt>Version</dt><dd>@MedStock.Web.Data.DbInitializer.AppVersion</dd>
</dl>

<h2>HTMX</h2>
<button type="button" hx-get="@Url.Page("/Diag", "Partial")" hx-target="#htmx-result" hx-swap="innerHTML">Load partial</button>
<p id="htmx-result" class="muted">(not loaded)</p>

<h2>Redirect</h2>
@if (Model.Redirected)
{
    <p class="ok">Redirect worked: you are back on the diagnostics page.</p>
}
<form method="post" asp-page-handler="Redirect">
    <button type="submit">Test redirect (POST + redirect)</button>
</form>

<h2>Camera and gallery</h2>
<label>Camera <input type="file" accept="image/*" capture="environment" data-echo="camera-size" /></label>
<p id="camera-size" class="small muted"></p>
<label>Gallery <input type="file" accept="image/*" data-echo="gallery-size" /></label>
<p id="gallery-size" class="small muted"></p>
<button type="button" id="gum">Test live camera (getUserMedia)</button>
<p id="gum-result" class="small muted"></p>
<video id="gum-video" playsinline muted width="240" hidden></video>

<h2>Notifications</h2>
@if (Model.ServicesError is not null)
{
    <p class="error">@Model.ServicesError</p>
}
else
{
    <form method="post" asp-page-handler="Notify">
        <fieldset>
            @foreach (var s in Model.Services)
            {
                <label><input type="checkbox" name="services" value="@s" checked="@(s.StartsWith("notify.mobile_app_"))" /> @s</label>
            }
        </fieldset>
        <button type="submit" name="variant" value="app">Send test (deep link /app/&lt;slug&gt;)</button>
        <button type="submit" name="variant" value="panel" class="secondary">Send test (deep link /&lt;slug&gt;)</button>
    </form>
}
@if (Model.NotifyResult is not null)
{
    <p>@Model.NotifyResult</p>
}

@section Scripts {
<script>
document.querySelectorAll('input[data-echo]').forEach(function (i) {
  i.addEventListener('change', function () {
    var f = i.files && i.files[0];
    document.getElementById(i.dataset.echo).textContent = f ? (f.name + ': ' + Math.round(f.size / 1024) + ' KB, ' + f.type) : '(none)';
  });
});
document.getElementById('gum').addEventListener('click', function () {
  var out = document.getElementById('gum-result');
  if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) { out.textContent = 'getUserMedia not available (needs https)'; return; }
  navigator.mediaDevices.getUserMedia({ video: { facingMode: 'environment' } }).then(function (stream) {
    var v = document.getElementById('gum-video'); v.hidden = false; v.srcObject = stream; v.play();
    out.textContent = 'getUserMedia works';
    setTimeout(function () { stream.getTracks().forEach(function (t) { t.stop(); }); v.hidden = true; }, 5000);
  }).catch(function (e) { out.textContent = 'getUserMedia failed: ' + e.name; });
});
</script>
}
