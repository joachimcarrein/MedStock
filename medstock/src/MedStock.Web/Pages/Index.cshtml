@page
@model IndexModel
@using System.Globalization
@{
    ViewData["Tab"] = "overview";
    var ui = CultureInfo.CurrentUICulture;
}
<h1>@L["Tab_Overview"]</h1>

@if (Model.Profiles.Count == 0)
{
    <div class="empty-state">
        <p>@L["Empty_NoProfiles"]</p>
        <a href="@Url.Page("/Settings/Profiles", new { next = "new" })" role="button">@L["Empty_NoProfiles_Button"]</a>
    </div>
}
else
{
    @if (Model.Profiles.Count > 1)
    {
        @* One small form per chip with a hidden field: iOS does not focus a tapped button, so a submit button's own
           name/value is not reliably sent along with a boosted form. *@
        <div class="chips" role="group" aria-label="@L["Med_Profile"]">
            <form method="post" asp-page-handler="Filter">
                <input type="hidden" name="profileId" value="" />
                <button type="submit" class="@(Model.Filter is null ? "active" : null)" aria-pressed="@(Model.Filter is null ? "true" : "false")">@L["Filter_All"]</button>
            </form>
            @foreach (var p in Model.Profiles)
            {
                var active = Model.Filter == p.Id;
                <form method="post" asp-page-handler="Filter">
                    <input type="hidden" name="profileId" value="@p.Id" />
                    <button type="submit" class="@(active ? "active" : null)" aria-pressed="@(active ? "true" : "false")"><span class="profile-dot" style="background:@p.Color"></span>@p.Name</button>
                </form>
            }
        </div>
    }

    @if (Model.Rows.Count == 0)
    {
        <p class="empty-state muted">@L["Empty_NoMedication"]</p>
    }
    else
    {
        <ul class="cards">
            @foreach (var r in Model.Rows)
            {
                var m = r.Medication;
                <li>
                    <a class="card state-@r.ColorClass" href="@Url.Page("/Medications/Details", new { id = m.Id })">
                        @if (Model.PhotoVersions.TryGetValue(m.Id, out var v) && v > 0)
                        {
                            <img class="thumb" src="@Url.Page("/Medications/Photo", new { id = m.Id, v })" alt="" width="64" height="64" loading="lazy" />
                        }
                        else
                        {
                            <span class="thumb"><partial name="_TypeIcon" model="m.Type" /></span>
                        }
                        <span class="body">
                            <span class="name">@m.Name @m.Strength</span>
                            <span class="meta"><span class="profile-dot" style="background:@r.Profile.Color"></span>@r.Profile.Name · @Texts.Quantity(m.Type, r.Stock, ui)</span>
                            <span class="status"><span class="badge @r.ColorClass"><partial name="_StateIcon" model="r.Stock.State" />@r.Badge(ui)</span>
                                @if (r.LastDose(ui) is { } lastDose)
                                {
                                    <span class="meta">@lastDose</span>
                                }
                            </span>
                        </span>
                    </a>
                </li>
            }
        </ul>
    }
    <a class="fab" href="@Url.Page("/Medications/Edit")" aria-label="@L["Med_New"]">+</a>
}
