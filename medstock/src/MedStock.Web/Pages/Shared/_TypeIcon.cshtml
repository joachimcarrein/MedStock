@model MedicationType
@* Simple line icons per medication type (no external assets). *@
<svg viewBox="0 0 24 24" aria-hidden="true" class="type-icon" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
@switch (Model)
{
    case MedicationType.Pill:
        <circle cx="12" cy="12" r="8" /><path d="M7 12h10" />
        break;
    case MedicationType.Capsule:
        <rect x="2.5" y="8" width="19" height="8" rx="4" transform="rotate(-45 12 12)" /><path d="M9.2 9.2l5.6 5.6" />
        break;
    case MedicationType.NasalSpray:
        <rect x="7" y="10" width="10" height="11" rx="2" /><path d="M10 10V6h4v4M11 6V3h2v3M17 4l2-1M17 6h2.5" />
        break;
    case MedicationType.Inhaler:
        <path d="M9 3h5v11h5v6a1 1 0 0 1-1 1h-8a1 1 0 0 1-1-1z" /><path d="M14 17h5" />
        break;
    case MedicationType.Drops:
        <path d="M12 3s-6 7-6 11a6 6 0 0 0 12 0c0-4-6-11-6-11z" />
        break;
    case MedicationType.Injection:
        <g transform="rotate(45 12 12)"><path d="M12 1.5V5M8 16h8M12 16v4.5M9.5 20.5h5" /><rect x="9.5" y="5" width="5" height="11" rx="1" /><path d="M9.5 8.5h2M9.5 11.5h2" /></g>
        break;
    case MedicationType.Sachet:
        <path d="M5 6l1.75-2 1.75 2 1.75-2L12 6l1.75-2 1.75 2 1.75-2L19 6v14H5z" /><path d="M9 12h6" />
        break;
    case MedicationType.Liquid:
        <path d="M10 2h4v4l2 3v12H8V9l2-3z" /><path d="M8 13h8" />
        break;
    default:
        <circle cx="12" cy="12" r="9" /><path d="M9.5 9.5a2.5 2.5 0 1 1 3.5 2.3c-.6.3-1 .9-1 1.6V14M12 17.5v.01" />
        break;
}
</svg>
